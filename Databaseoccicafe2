-------------------------------------------------------------
-- CONSULTAS (SELECT)
-------------------------------------------------------------

-- 1. Listar productores registrados
SELECT * FROM PRODUCTOR;

-- 2. Mostrar compras mayores a 1600 kg
SELECT * FROM COMPRA
WHERE peso_kg > 1600;

-- 3. Total comprado por productor
SELECT P.nombre,
       SUM(C.peso_kg) AS total_kg
FROM PRODUCTOR P, COMPRA C
WHERE P.id_productor = C.id_productor
GROUP BY P.nombre;

-- 4. Detalle completo de compras
SELECT C.id_compra,
       P.nombre AS productor,
       CF.tipo_cafe,
       C.peso_kg,
       C.precio_kg,
       (C.peso_kg * C.precio_kg) AS total_compra
FROM COMPRA C, PRODUCTOR P, CAFE CF
WHERE C.id_productor = P.id_productor
AND C.id_cafe = CF.id_cafe;

-- 5. Total pagado por compra
SELECT * FROM PAGO;

