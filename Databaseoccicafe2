/* ==========================================================
   PROYECTO: DISEÑO DE BASE DE DATOS
   EMPRESA: Occicafé
   DESCRIPCIÓN: Base de datos para gestión de compra
                de café verde y seco.
   ========================================================== */

-------------------------------------------------------------
-- ELIMINAR TABLAS (SI EXISTEN) - ORDEN CORRECTO
-------------------------------------------------------------

DROP TABLE PAGO CASCADE CONSTRAINTS;
DROP TABLE COMPRA CASCADE CONSTRAINTS;
DROP TABLE CAFE CASCADE CONSTRAINTS;
DROP TABLE PRODUCTOR CASCADE CONSTRAINTS;

-------------------------------------------------------------
-- CREACIÓN DE TABLAS (DDL)
-------------------------------------------------------------

-- TABLA PRODUCTOR
CREATE TABLE PRODUCTOR (
    id_productor      NUMBER PRIMARY KEY,
    nombre            VARCHAR2(100) NOT NULL,
    cedula            VARCHAR2(20) UNIQUE NOT NULL,
    telefono          VARCHAR2(20),
    municipio         VARCHAR2(100)
);

-- TABLA CAFE
CREATE TABLE CAFE (
    id_cafe           NUMBER PRIMARY KEY,
    tipo_cafe         VARCHAR2(50) CHECK (tipo_cafe IN ('Verde','Seco')),
    calidad           VARCHAR2(50)
);

-- TABLA COMPRA
CREATE TABLE COMPRA (
    id_compra         NUMBER PRIMARY KEY,
    id_productor      NUMBER NOT NULL,
    id_cafe           NUMBER NOT NULL,
    fecha_compra      DATE DEFAULT SYSDATE,
    peso_kg           NUMBER(10,2) CHECK (peso_kg > 0),
    precio_kg         NUMBER(10,2) CHECK (precio_kg > 0),

    CONSTRAINT fk_compra_productor
        FOREIGN KEY (id_productor)
        REFERENCES PRODUCTOR(id_productor),

    CONSTRAINT fk_compra_cafe
        FOREIGN KEY (id_cafe)
        REFERENCES CAFE(id_cafe)
);

-- TABLA PAGO
CREATE TABLE PAGO (
    id_pago           NUMBER PRIMARY KEY,
    id_compra         NUMBER NOT NULL,
    fecha_pago        DATE DEFAULT SYSDATE,
    total_pagado      NUMBER(12,2),

    CONSTRAINT fk_pago_compra
        FOREIGN KEY (id_compra)
        REFERENCES COMPRA(id_compra)
);

